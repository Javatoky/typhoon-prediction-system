# 复制为 backend/.env 后按需修改。
# 该文件由 config.py 通过 python-dotenv 读取，优先级低于真实的操作系统环境变量。
# 注意：backend/.env 已被 .gitignore 排除，禁止把真实密钥提交到仓库。

# 运行模式：development / testing / production
DSH_APP_ENV=development

# Flask 会话密钥。生产环境必须改成随机值：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# 服务监听地址（仅用于 scripts/run_server.py 与生产启动）
HOST=127.0.0.1
PORT=5000
WAITRESS_THREADS=4

# 会话空闲失效时间（分钟），对应 NFR-008
SESSION_IDLE_MINUTES=30
# 连续登录失败次数上限与锁定时长（分钟），对应 UC-01 扩展流程
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 上传限制（MB），对应 FR-004 / NFR-004
MAX_UPLOAD_MB=20
# 模型权重上传限制（MB），对应 FR-014
MAX_MODEL_MB=200

# 初始管理员账号（仅 scripts/init_db.py --seed 使用，首次登录后请立即改密）
# 注意：密码不能包含用户名，且需至少包含大写/小写/数字/符号中的两类。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Adm1n@2024

# 数据库位置，留空表示使用 backend/instance/typhoon.sqlite
# DATABASE_URL=sqlite:///E:/path/to/typhoon.sqlite

# 日志文件开关，留空表示只输出到控制台
# LOG_FILE=backend/instance/logs/app.log
